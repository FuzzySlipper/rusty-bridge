<Project Sdk="Microsoft.NET.Sdk">
  <!-- What the mirror and the combat lab both read from dm-import's models, and the contact sweep both use, so the
       lab's blows and the mirror's Shadow contacts are measured the same way. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
  </ItemGroup>
</Project>
