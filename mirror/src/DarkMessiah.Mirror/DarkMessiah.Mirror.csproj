<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineProductEntryType>DarkMessiah.Mirror.MirrorProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>rusty-bridge.darkmessiah-mirror</RustyEngineProductId>
    <RustyEngineProductTitle>Dark Messiah mirror</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$(MSBuildProjectDirectory)/../ui</RustyEngineProductUiRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <!-- The content is what dm-import wrote: GLBs, <map>.assets.json and the recording it was imported
         for. It is derived from the donor's files and never tracked; see docs/mirror.md. -->
    <RustyEngineProductContentRoot>$(MSBuildProjectDirectory)/../../../local/import</RustyEngineProductContentRoot>
    <RustyEngineProductUiProjectionStream>darkmessiah-mirror</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>rusty-bridge.mirror.status</RustyEngineProductUiProjectionContract>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
  </PropertyGroup>

  <ItemGroup>
    <RustyEngineProductInputIntent Include="mirror.toggle" Value="digital" />
    <RustyEngineProductInputIntent Include="mirror.step.forward" Value="digital" />
    <RustyEngineProductInputIntent Include="mirror.step.back" Value="digital" />
    <RustyEngineProductInputIntent Include="mirror.faster" Value="digital" />
    <RustyEngineProductInputIntent Include="mirror.slower" Value="digital" />
    <RustyEngineProductInputIntent Include="mirror.camera" Value="digital" />
    <RustyEngineProductInputMapping Include="mirror.toggle.space" Intent="mirror.toggle" Trigger="key:space:pressed" />
    <RustyEngineProductInputMapping Include="mirror.step.forward.arrow-right" Intent="mirror.step.forward" Trigger="key:arrow-right:pressed" />
    <RustyEngineProductInputMapping Include="mirror.step.back.arrow-left" Intent="mirror.step.back" Trigger="key:arrow-left:pressed" />
    <RustyEngineProductInputMapping Include="mirror.faster.arrow-up" Intent="mirror.faster" Trigger="key:arrow-up:pressed" />
    <RustyEngineProductInputMapping Include="mirror.slower.arrow-down" Intent="mirror.slower" Trigger="key:arrow-down:pressed" />
    <RustyEngineProductInputMapping Include="mirror.camera.key-c" Intent="mirror.camera" Trigger="key:key-c:pressed" />
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
    <ProjectReference Include="../../../wire/RustyBridge.Wire/RustyBridge.Wire.csproj" />
  </ItemGroup>

  <!-- Staging an absent import would publish a product that fails at start, so stop here with the command. -->
  <Target Name="RequireImportedContent" BeforeTargets="StageRustyEngineProductAssets">
    <ItemGroup>
      <_MirrorIndex Include="$(RustyEngineProductContentRoot)/*.assets.json" />
    </ItemGroup>
    <Error Condition="'@(_MirrorIndex)' == ''"
           Text="No imported level in $(RustyEngineProductContentRoot). It is derived from the game's files and not tracked: copy the VPKs to local/donor/vpks, then run `dotnet run --project import/DarkMessiah.Import.Tool -- level local/recordings/&lt;fight&gt;.rbrec` (docs/import.md)." />
  </Target>
</Project>
