<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineProductEntryType>DarkMessiah.Lab.LabProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>rusty-bridge.darkmessiah-lab</RustyEngineProductId>
    <RustyEngineProductTitle>Dark Messiah combat lab</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$(MSBuildProjectDirectory)/../ui</RustyEngineProductUiRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <!-- The lab's own content; the donor's (dm-import's output) is packed and opened at run time (docs/lab.md). -->
    <RustyEngineProductContentRoot>$(MSBuildProjectDirectory)/../../content</RustyEngineProductContentRoot>
    <RustyEngineProductUiProjectionStream>darkmessiah-lab</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>rusty-bridge.lab.hud</RustyEngineProductUiProjectionContract>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEngineProductInputCursorMode>pointer-lock</RustyEngineProductInputCursorMode>
    <RustyEngineWatchPaths>$(MSBuildProjectDirectory);$(RustyEngineProductUiRoot);$(RustyEngineProductContentRoot)</RustyEngineWatchPaths>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
    <ProjectReference Include="../../../shared/DarkMessiah.Shared/DarkMessiah.Shared.csproj" />
    <ProjectReference Include="../../../combat/DarkMessiah.Combat/DarkMessiah.Combat.csproj" />
    <ProjectReference Include="../../../wire/RustyBridge.Wire/RustyBridge.Wire.csproj" />
    <RustyEngineProductInputIntent Include="reset" Value="digital" />
    <RustyEngineProductInputMapping Include="reset.key-r" Intent="reset" Trigger="key:key-r:pressed" />
    <!-- Reloaded in place under `rusty dev` (and by tunables Save): the body/camera feel and the fight's own numbers. -->
    <RustyEngineLiveContent Include="player.json" />
    <RustyEngineLiveContent Include="combat.json" />
    <RustyEngineLiveContent Include="build.json" />
  </ItemGroup>
</Project>
